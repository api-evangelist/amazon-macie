{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-macie/refs/heads/main/json-schema/amazon-macie-job-schedule-frequency-schema.json",
  "title": "JobScheduleFrequency",
  "description": "Specifies the recurrence pattern for running a classification job.",
  "type": "object",
